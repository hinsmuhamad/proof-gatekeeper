# Copy to .env and fill in. NEVER commit a real .env.
# Required in production: the one-time plaintext from the Agent Games
# dashboard ("Rotate Secret"). Without it /agent rejects every request.
AGENT_GAMES_HMAC_SECRET=
# Optional: Kurier mainnet API key (https://kurier.xyz). Needed to submit
# decision proofs to zkVerify and to check incoming-proof finalization.
# Without it, decisions are still served and proofs are generated locally.
KURIER_API_KEY=
# Optional overrides:
# KURIER_API_URL=https://api.kurier.xyz/api/v1
# PORT=3000
# PROOF_BUDGET_MS=20000
# STATE_DIR=./state
